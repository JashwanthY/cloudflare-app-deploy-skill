# Production image for the FastAPI backend — generated by cloudflare-app-deploy, edit freely.
# Cloudflare Containers run linux/amd64; `wrangler containers build` targets that automatically.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
__SYSTEM_PACKAGES__
__INSTALL_DEPS__
COPY . .
__POST_COPY__
EXPOSE __PORT__
# Exec form so SIGTERM reaches the server and in-flight requests can finish on rollouts.
__CMD__
